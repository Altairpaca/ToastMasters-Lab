{
  "name": "club-brain",
  "version": "2.0.0",
  "description": "Club Console — an offline, application-grade console for Toastmasters club operations: agenda linting, live meeting cockpit, projection, retro, scheduling and DCP tracking.",
  "keywords": [
    "toastmasters",
    "club-operations",
    "offline",
    "single-file",
    "agenda",
    "timer",
    "dcp"
  ],
  "author": "Altair Li <altairpaca@gmail.com>",
  "license": "MIT",
  "main": "src/index.js",
  "bin": {
    "club-brain": "src/cli.js"
  },
  "files": [
    "src",
    "app",
    "build",
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build/build.js",
    "test": "node --test test/agenda.test.js test/toolkit.test.js test/finance-feedback.test.js test/survey.test.js",
    "test:e2e": "node test/smoke.mjs",
    "demo": "node src/cli.js demo",
    "start": "node build/build.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Altairpaca/club-brain.git"
  },
