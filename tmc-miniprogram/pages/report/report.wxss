/* tmc-miniprogram/pages/report/report.wxss */
.page { padding: 24rpx; background: #f4f6fb; min-height: 100vh; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,65,101,0.06); }
.tabs { display: flex; }
.tab { flex: 1; text-align: center; padding: 16rpx 0; font-size: 28rpx; color: #6b7785; border-bottom: 4rpx solid transparent; }
.tab-on { color: #004165; font-weight: 700; border-bottom-color: #004165; }
.subtabs { display: flex; align-items: center; margin-top: 16rpx; }
.subtab { padding: 8rpx 20rpx; font-size: 26rpx; color: #6b7785; border-radius: 24rpx; margin-right: 12rpx; }
.subtab-on { background: #e6eef4; color: #004165; }
.mini-btn { margin: 0 0 0 auto; background: #004165; color: #fff; font-size: 24rpx; line-height: 2.2; padding: 0 20rpx; border-radius: 8rpx; }
.md { font-size: 26rpx; color: #1f2d3d; white-space: pre-wrap; line-height: 1.6; }
