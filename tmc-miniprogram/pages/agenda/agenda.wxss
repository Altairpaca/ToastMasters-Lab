/* tmc-miniprogram/pages/agenda/agenda.wxss */
.page { padding: 24rpx; background: #f4f6fb; min-height: 100vh; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,65,101,0.06); }
.row { display: flex; align-items: center; margin-bottom: 16rpx; }
.label { width: 160rpx; color: #004165; font-size: 28rpx; }
.input { flex: 1; border: 1rpx solid #d0d7de; border-radius: 10rpx; padding: 12rpx 16rpx; font-size: 28rpx; }
.btn { background: #004165; color: #fff; font-size: 28rpx; border-radius: 10rpx; margin-top: 8rpx; }
.net { display: block; margin-top: 12rpx; color: #6b7785; font-size: 24rpx; }
.summary { color: #1f2d3d; font-size: 28rpx; line-height: 1.6; }
.warn { margin-top: 12rpx; }
.warn-item { color: #b45309; font-size: 24rpx; }
.thead, .tr { display: flex; border-bottom: 1rpx solid #eef1f5; }
.th { flex: 1; padding: 14rpx 8rpx; font-size: 24rpx; color: #004165; font-weight: 600; }
.td { flex: 1; padding: 16rpx 8rpx; font-size: 26rpx; color: #1f2d3d; }
.empty { text-align: center; color: #9aa5b1; font-size: 26rpx; padding: 40rpx 0; }
