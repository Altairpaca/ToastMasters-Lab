<!-- tmc-miniprogram/pages/agenda/agenda.wxml -->
<view class="page">
  <view class="card">
    <view class="row">
      <text class="label">会议 ID</text>
      <input class="input" value="{{meetingId}}" placeholder="2026-10-08_第335次" bindinput="onId" />
    </view>
    <button class="btn" bindtap="build">刷新议程</button>
    <text class="net">网络能力：{{netAvailable ? '在线' : '离线（只读协作）'}}</text>
  </view>

  <view class="card" wx:if="{{summary}}">
    <view class="summary">{{summary}}</view>
    <view class="warn" wx:if="{{warnings.length}}">
      <view wx:for="{{warnings}}" wx:key="*this" class="warn-item">⚠ {{item}}</view>
    </view>
  </view>

  <view class="card">
    <view class="thead">
      <view wx:for="{{headers}}" wx:key="*this" class="th">{{item}}</view>
    </view>
    <view wx:for="{{rows}}" wx:key="index" class="tr">
      <view wx:for="{{item.cells}}" wx:for-item="cell" wx:key="index" class="td">{{cell}}</view>
    </view>
    <view class="empty" wx:if="{{!rows.length}}">暂无议程数据</view>
  </view>
</view>
